# Resend — use Sending access only (not Full access)
RESEND_API_KEY=

# Where contact form leads are delivered
CONTACT_TO_EMAIL=manav@productpartner.net

# Verified Resend sender. Prefer your domain once verified in Resend.
# Fallback for testing: Product Partner <onboarding@resend.dev>
RESEND_FROM_EMAIL=Product Partner <noreply@productpartner.net>

# Supabase Postgres — Session pooler URI (port 5432). Replace [YOUR-PASSWORD].
DATABASE_URI=postgresql://postgres.kznlwggfprbcpwjyxebp:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Payload admin secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Supabase Storage, used as S3 for Payload media (case study images).
# Create a public bucket named media, then copy the keys from Storage → S3.
S3_BUCKET=media
S3_REGION=ap-south-1
S3_ENDPOINT=https://kznlwggfprbcpwjyxebp.storage.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://kznlwggfprbcpwjyxebp.supabase.co/storage/v1/object/public/media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
